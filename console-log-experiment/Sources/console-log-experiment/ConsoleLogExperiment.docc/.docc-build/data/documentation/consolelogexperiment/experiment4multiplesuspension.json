{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment1SynchronousPath","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment2AsyncNoAwait","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension"],"title":"Experiments","generated":true,"anchor":"Experiments"}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"heading","level":3,"anchor":"Purpose","text":"Purpose"},{"type":"paragraph","inlineContent":[{"text":"Experiment 4 demonstrates multiple suspension points in an async function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The implementation is designed to show how a task repeatedly suspends and resumes when it encounters multiple "},{"code":"await","type":"codeVoice"},{"text":" boundaries during execution.","type":"text"}]},{"level":3,"text":"Source Example","anchor":"Source-Example","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The async function contains two suspension points:"}]},{"type":"codeListing","syntax":"swift","code":["func asyncFunctionWithMultipleAwait() async {","    print(\"[Task#00] Enter Async Function\")","","    print(\"[Task#00] Suspending Task\")","    try? await Task.sleep(for: .seconds(1))","    print(\"[Task#00] Task Resumed\")","    print(\"[Task#00] Continue After await\")","    print(\"[Task#00] More await Points? -> Yes\")","","    print(\"[Task#00] Suspending Task\")","    try? await Task.sleep(for: .seconds(1))","    print(\"[Task#00] Task Resumed\")","    print(\"[Task#00] Continue After await\")","    print(\"[Task#00] More await Points? -> No\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The runner schedules additional concurrent work:","type":"text"}]},{"type":"codeListing","code":["func runMultipleSuspensionPath() {","    print(\"[Task#00] Start: Main Thread\")","","    for index in 1...6 {","        Task {","            try? await Task.sleep(for: .seconds(Double(index) * 0.3))","            print(\"[Task#0\\\\(index)] Other Tasks Running\")","        }","    }","","    Task {","        print(\"[Task#00] async\/await Task Created\")","        await asyncFunctionWithMultipleAwait()","        print(\"[Task#00] End: Task Finished - Return to Main Thread\")","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Execution Flow","anchor":"Execution-Flow"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The experiment starts on the main thread."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Additional tasks are scheduled to represent other work."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The primary async task is created."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The task enters the async function.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The first "},{"type":"codeVoice","code":"await"},{"type":"text","text":" causes suspension and later resumption."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The function continues and confirms that more suspension points remain."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The second "},{"code":"await","type":"codeVoice"},{"type":"text","text":" causes another suspension and later resumption."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After the second continuation, the function reaches its final completion message."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Task Behavior","anchor":"Task-Behavior"},{"type":"paragraph","inlineContent":[{"text":"This experiment repeats the suspension and resumption cycle more than once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"try? await Task.sleep(for: .seconds(1))"},{"type":"text","text":" marks a point where the primary task yields control. While that task is suspended, other tasks that were scheduled by the runner may continue to log their progress."}]},{"inlineContent":[{"text":"The experiment is intended to make repeated async boundaries visible in the console trace.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Suspension Points","anchor":"Suspension-Points","type":"heading"},{"inlineContent":[{"type":"text","text":"The experiment has two suspension points:"}],"type":"paragraph"},{"syntax":"swift","code":["try? await Task.sleep(for: .seconds(1))","try? await Task.sleep(for: .seconds(1))"],"type":"codeListing"},{"level":3,"type":"heading","text":"Console Output Meaning","anchor":"Console-Output-Meaning"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Console Output"}]}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Start: Main Thread"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The experiment begins before the async task body runs."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] async\/await Task Created"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The primary task has been created.","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] Enter Async Function"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Control enters the async function.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Suspending Task"}]}],[{"inlineContent":[{"type":"text","text":"The primary task is about to suspend at an "},{"type":"codeVoice","code":"await"},{"type":"text","text":" boundary."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"[Task#0x] Other Tasks Running","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Concurrent work runs while the primary task is suspended."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"[Task#00] Task Resumed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The primary task resumes after the awaited operation completes."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Continue After await"}]}],[{"type":"paragraph","inlineContent":[{"text":"Execution continues after the current suspension point.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] More await Points? -> Yes"}]}],[{"inlineContent":[{"text":"The first resumption is followed by another suspension point.","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"[Task#00] More await Points? -> No","type":"codeVoice"}]}],[{"inlineContent":[{"text":"The second resumption completes the final async boundary.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"[Task#00] End: Task Finished - Return to Main Thread","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The experiment prints its final completion message.","type":"text"}]}]]],"header":"row"},{"anchor":"Flow-Chart-Mapping","text":"Flow Chart Mapping","type":"heading","level":3},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Flow Chart Step","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Corresponding Output or Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Start: Main Thread","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Start: Main Thread"}]}]],[[{"inlineContent":[{"text":"Is the task created with async\/await? -> Yes","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Task { ... }"},{"text":" in ","type":"text"},{"code":"runMultipleSuspensionPath()","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"text","text":"async\/await Task Created"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] async\/await Task Created"}]}]],[[{"inlineContent":[{"type":"text","text":"Enter Async Function"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Enter Async Function"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Encounter await? -> Yes","type":"text"}]}],[{"inlineContent":[{"text":"The first ","type":"text"},{"code":"try? await Task.sleep(for: .seconds(1))","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Suspending Task"}]}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] Suspending Task"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Suspend Task \/ Yield control to runtime","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"Task.sleep"},{"type":"text","text":" call"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Execute Other Work \/ Perform Other Work","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The additional tasks created in the "},{"type":"codeVoice","code":"for index in 1...6"},{"text":" loop","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Other Tasks Running"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[Task#01] Other Tasks Running","type":"codeVoice"},{"type":"text","text":" through "},{"type":"codeVoice","code":"[Task#06] Other Tasks Running"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resume Task"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Task Resumed"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Continue After await","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Continue After await"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"More await Points? -> Yes"}]}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] More await Points? -> Yes"},{"type":"text","text":" after the first resumption"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Repeat Suspension \/ Resume Cycle","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The second "},{"code":"Task.sleep","type":"codeVoice"},{"type":"text","text":" and following resumption logs"}]}]],[[{"inlineContent":[{"text":"More await Points? -> No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] More await Points? -> No"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Final Completion"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[Task#00] End: Task Finished - Return to Main Thread","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"Implementation Notes","type":"heading","level":3,"anchor":"Implementation-Notes"},{"type":"paragraph","inlineContent":[{"text":"The source code notes that output order may vary due to Swift Concurrency scheduling.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That matters here because the experiment intentionally mixes a primary task with additional delayed tasks, so the relative order of some console lines is part of what the experiment is meant to expose.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment4MultipleSuspension"},"kind":"article","abstract":[{"text":"An experiment that shows repeated suspension and resumption across multiple ","type":"text"},{"type":"codeVoice","code":"await"},{"type":"text","text":" boundaries in the same async task."}],"hierarchy":{"paths":[["doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Experiment 4: Multiple Suspension"},"references":{"doc://ConsoleLogExperiment/documentation/ConsoleLogExperiment/Experiment1SynchronousPath":{"url":"\/documentation\/consolelogexperiment\/experiment1synchronouspath","type":"topic","identifier":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment1SynchronousPath","title":"Experiment 1: Synchronous Path","role":"article","abstract":[{"type":"text","text":"The baseline experiment for the project, showing a fully synchronous execution path without "},{"type":"codeVoice","code":"async"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"kind":"article"},"doc://ConsoleLogExperiment/documentation/ConsoleLogExperiment/Experiment3SingleSuspension":{"url":"\/documentation\/consolelogexperiment\/experiment3singlesuspension","type":"topic","abstract":[{"text":"An experiment that makes one ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" boundary visible so suspension, runtime handoff, and resumption can be observed through console output.","type":"text"}],"title":"Experiment 3: Single Suspension","role":"article","kind":"article","identifier":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension"},"doc://ConsoleLogExperiment/documentation/ConsoleLogExperiment/Experiment2AsyncNoAwait":{"identifier":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment2AsyncNoAwait","title":"Experiment 2: Async Task Without Await","url":"\/documentation\/consolelogexperiment\/experiment2asyncnoawait","type":"topic","role":"article","abstract":[{"type":"text","text":"An experiment that creates an asynchronous "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" while keeping the async function body free of suspension points."}],"kind":"article"},"doc://ConsoleLogExperiment/documentation/ConsoleLogExperiment":{"abstract":[{"text":"An executable Swift Package that studies Swift Concurrency through small console log experiments focused on task creation, suspension, and resumption.","type":"text"}],"identifier":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment","kind":"article","role":"collection","type":"topic","title":"console-log-experiment","url":"\/documentation\/consolelogexperiment"}}}