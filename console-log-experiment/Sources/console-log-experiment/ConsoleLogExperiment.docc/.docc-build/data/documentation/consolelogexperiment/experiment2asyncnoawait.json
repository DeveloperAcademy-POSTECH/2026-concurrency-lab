{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"level":3,"type":"heading","anchor":"Purpose","text":"Purpose"},{"inlineContent":[{"type":"text","text":"Experiment 2 enters an asynchronous "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" context, but the async function body contains no suspension point."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"According to the repository documentation, this experiment is intended to show that an async function can still execute sequentially when no "},{"code":"await","type":"codeVoice"},{"type":"text","text":" is encountered."}]},{"type":"heading","text":"Source Example","anchor":"Source-Example","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The experiment is driven by these functions:"}]},{"type":"codeListing","code":["func asyncFunctionWithoutAwait() async {","    print(\"[Task#00] Enter Async Function\")","    print(\"[Task#00] Execute task Synchronously\")","}","","func runAsyncNoAwaitPath() {","    print(\"[Task#00] Start: Main Thread\")","","    Task {","        print(\"[Task#00] async\/await Task Created\")","        await asyncFunctionWithoutAwait()","        print(\"[Task#00] End: Return to Main Thread\")","    }","}"],"syntax":"swift"},{"type":"heading","text":"Execution Flow","anchor":"Execution-Flow","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The experiment starts on the main thread.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Swift Concurrency "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" is created."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The task enters the async function.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The async function body executes sequentially.","type":"text"}]}]},{"content":[{"type":"p