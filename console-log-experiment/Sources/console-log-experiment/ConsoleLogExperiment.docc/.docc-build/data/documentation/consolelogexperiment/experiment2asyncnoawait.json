","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Execute task Synchronously","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[Task#00] Execute task Synchronously","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"End: Return to Main Thread"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] End: Return to Main Thread"}],"type":"paragraph"}]]],"type":"table"},{"text":"Implementation Note","level":3,"type":"heading","anchor":"Implementation-Note"},{"inlineContent":[{"text":"This experiment separates two ideas:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"entering an async context by creating a "},{"type":"codeVoice","code":"Task"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"suspending execution by encountering ","type":"text"},{"type":"codeVoice","code":"await"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first happens here, but the second does not occur inside the experiment function body."}]}],"kind":"content"}],"abstract":[{"text":"An experiment that creates an asynchronous ","type":"text"},{"type":"codeVoice","code":"Task"},{"type":"text","text":" while keeping the async function body free of suspension points."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension"],"anchor":"Related-Documentation"},{"title":"Experiments","identifiers":["doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment1SynchronousPath","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension","doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLo