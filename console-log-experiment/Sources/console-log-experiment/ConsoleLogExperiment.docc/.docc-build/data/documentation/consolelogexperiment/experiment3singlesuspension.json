: Return to Main Thread"}]}],[{"type":"paragraph","inlineContent":[{"text":"The primary task prints its final completion log.","type":"text"}]}]]],"header":"row","type":"table"},{"anchor":"Flow-Chart-Mapping","type":"heading","level":3,"text":"Flow Chart Mapping"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Flow Chart Step"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Corresponding Output or Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Start: Main Thread","type":"text"}]}],[{"inlineContent":[{"code":"[Task#00] Start: Main Thread","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Is the task created with async\/await? -> Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Task { ... }"},{"type":"text","text":" in "},{"code":"runSingleSuspensionPath()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"async\/await Task Created","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] async\/await Task Created"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Enter Async Function"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] Enter Async Function"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Encounter await? -> Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[Task#00] Encounter await"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Suspending Task","type":"text"}]}],[{"inlineContent":[{"code":"[Task#00] Suspending Task","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Suspend Task \/ Yield control to runtime"}]}],[{"inlineContent":[{"type":"codeVoice","code":"try? await Task.sleep(for: .seconds(1))"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Execute Other Work \/ Perform O