{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ConsoleLogExperiment\/documentation\/ConsoleLogExperiment\/Experiment3SingleSuspension"},"abstract":[{"type":"text","text":"An experiment that makes one "},{"code":"await","type":"codeVoice"},{"type":"text","text":" boundary visible so suspension, runtime handoff, and resumption can be observed through console output."}],"sections":[],"kind":"article","metadata":{"role":"article","title":"Experiment 3: Single Suspension","roleHeading":"Article"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"anchor":"Purpose","type":"heading","level":3,"text":"Purpose"},{"inlineContent":[{"type":"text","text":"Experiment 3 demonstrates a single suspension point in an async function."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The implementation and repository description show this experiment is intended to observe:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"where execution is suspended"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"how control is yielded to the runtime","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"how and when the task resumes execution"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"how other work can interleave while the task is suspended"}]}]}]},{"anchor":"Source-Example","text":"Source Example","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The single suspension point is implemented with "},{"type":"codeVoice","code":"Task.sleep"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func asyncFunctionWithSingleSuspension() async {","    print(\"[Task#00] Enter Async Function\")","    print(\"[Task#00] Encounter await\")","    print(\"[Task#00] Suspending Task\")","","    try? await Task.sleep(for: .seconds(1))","","    print(\"[Task#00] Async Operation Completed\")","    print(\"[Task#00] Task Resumed\")","    print(\"[Task#00] Continue After await\")","    print(\"[Task#00] More await Points? -> No\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The experiment runner also starts additional Tasks:","type":"text"}]},{"code":["func runSingleSuspensionPath() {","    print(\"[Task#00] Start: Main Thread\")","","    Task {","        print(\"[Task#00] async\/await Task Created\")","        await asyncFunctionWithSingleSuspension()","        print(\"[Task#00] End: Return to Main Thread\")","    }","","    for index in 1...3 {","        Task {","            print(\"[Task#0\\\\(index)] Other Tasks Running\")","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Execution Flow","anchor":"Execution-Flow","type":"heading","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The experiment starts on the main thread.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The primary async "},{"type":"codeVoice","code":"Task"},{"text":" is created.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The task enters the async function.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The function reaches "},{"type":"codeVoice","code":"await"},{"text":" and logs that suspension is about to happen.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Task.sleep"},{"type":"text","text":" becomes the suspension point."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While the primary task is suspended, other tasks can run."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After the async operation completes, the suspended task resumes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The function continues after "},{"type":"codeVoice","code":"await"},{"text":" and prints its completion logs.","type":"text"}]}]}]},{"anchor":"Task-Behavior","level":3,"text":"Task Behavior","type":"heading"},{"inlineContent":[{"text":"This experiment makes the suspension and resumption cycle visible in console output.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The primary task yields control when it reaches ","type":"text"},{"code":"try? await Task.sleep(for: .seconds(1))","type":"codeVoice"},{"text":". After that async operation completes, execution resumes from the continuation point and proceeds with the remaining logs.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additional tasks are created outside the primary task to show that other work can be scheduled while the suspended task is waiting."}]},{"anchor":"Suspension-Point","level":3,"text":"Suspension Point","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The suspension point is:","type":"text"}]},{"syntax":"swift","code":["try? await Task.sleep(for: .seconds(1))"],"type":"codeListing"},{"inlineContent":[{"text":"This is the single ","type":"text"},{"code":"await","type":"codeVoice"},{"type":"text","text":" boundary in the experiment."}],"type":"paragraph"},{"level":3,"text":"Console Output Meaning","type":"heading","anchor":"Console-Output-Meaning"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Console Output"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Meaning","type":"text"}]}]],[[{"inlineContent":[{"code":"[Task#00] Start: Main Thread","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The experiment begins before the async task body runs.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"[Task#00] async\/await Task Created"}],"type":"paragraph"}],[{"type":"paragr